{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  // Vendored agent skills ship their own scripts and assets.
  "ignore": [".agents/**", ".claude/skills/**"],
  // Public type of the app config, imported by derived tooling later.
  "ignoreIssues": { "app.config.ts": ["types"] },
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{mjs,ts}", "tools/**/*.ts"],
    },
    "apps/native": {
      // The local database factory is consumed by the sync wiring (a later phase); the Expo
      // config plugin and local module are loaded by Expo, not imported.
      "entry": [
        "src/platform/local-database/index.ts",
        "plugins/*.js",
        "modules/*/index.ts",
        // Sync status for the phase 6 UI (the hook is exported before a screen uses it).
        "src/sync/index.ts",
      ],
      // Expo reads these through app.config.ts and the Metro/Babel presets. The PowerSync and
      // op-sqlite packages are used by openNativeDatabase; expo-crypto by the polyfill.
      // expo-font is the peer @expo-google-fonts/inter loads Inter through.
      "ignoreDependencies": ["@workspace/config", "expo-font"],
    },
    "packages/api": {
      // Declaration files of the router name types from @orpc/shared (TS2883 without it).
      "ignoreDependencies": ["@orpc/shared"],
    },
    "packages/ui": {
      // Components are installed from the coss registry and used by the apps,
      // so most of their exports and dependencies look unused from here.
      "ignoreIssues": { "src/components/**": ["exports", "types"], "src/hooks/**": ["exports"] },
    },
  },
}
