{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "jsPlugins": [
    { "name": "boundaries", "specifier": "./scripts/lint/boundaries-plugin.mjs" },
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" },
    { "name": "hermes", "specifier": "./scripts/lint/hermes-plugin.mjs" }
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "boundaries/vertical-boundaries": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": ["error", { "allowInTypeGuards": true }],
    "anti-slop/no-shape-in-symbol-names": "error"
  },
  "overrides": [
    {
      // Code that runs on the device (Hermes); tests and Node scripts run on Node.
      "files": [
        "apps/native/src/**",
        "apps/native/app/**",
        "packages/shared/src/**",
        "packages/sync/src/**",
        "packages/client/src/**",
        "packages/i18n/src/**",
        "packages/ui/src/**"
      ],
      "rules": {
        "hermes/no-es2023-array-methods": "error"
      }
    },
    {
      // Repo tooling is plain JavaScript without zod; `typeof` is its boundary check.
      "files": ["scripts/**", "tools/**"],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx,mjs}"],
      "rules": {
        "anti-slop/no-chained-type-assertions": "off",
        "anti-slop/no-known-value-widening": "off",
        "anti-slop/require-safety-comment-for-type-assertion": "off",
        "hermes/no-es2023-array-methods": "off"
      }
    },
    {
      // Generates the body-map assets on Node at build time; never bundled.
      "files": ["apps/native/src/body-map/generate-assets.ts"],
      "rules": {
        "hermes/no-es2023-array-methods": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/routeTree.gen.ts",
    "**/.expo/**",
    "repos/**",
    "tools/oxlint/anti-slop/**",
    ".agents/**",
    ".claude/**",
    ".scratch/**"
  ],
  "env": {
    "builtin": true
  }
}
