# Values for compose.prod.yml, the local production check (docs/deployment.md, "Local production
# check"). Copy to .env.prod, which git ignores, and replace every REPLACE_ value. The server
# and the bootstrap run with NODE_ENV=production and refuse placeholders, so generate them:
#
#   openssl rand -hex 32   # BETTER_AUTH_SECRET, PS_ADMIN_TOKEN, MEDIA_S3_SECRET_ACCESS_KEY
#   openssl rand -hex 24   # POSTGRES_PASSWORD, APP_DB_PASSWORD, POWERSYNC_*_PASSWORD (they go
#                          # into connection URLs, so URL-safe characters only)
#
# Never put real production values in this stack or in a committed file.

# Host ports, bound to 127.0.0.1. Keep them away from the development stack (3000, 5432, 8090,
# 9000).
API_HOST_PORT=13000
POWERSYNC_HOST_PORT=18090

# Postgres 18 with logical replication. The WAL budget is a check-sized value, not a sizing.
# POSTGRES_USER is the superuser: only the bootstrap job uses it. The server connects as
# APP_DB_USER, an unprivileged role that owns the database (created when the volume is new).
POSTGRES_DB=vermillion
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_24
APP_DB_USER=vermillion
APP_DB_PASSWORD=REPLACE_WITH_openssl_rand_hex_24
POSTGRES_MAX_SLOT_WAL_KEEP_SIZE=1GB

# Server. APP_URL is the origin you call the API on; SYNC_ENDPOINT_URL is what clients are told.
APP_URL=http://127.0.0.1:13000
SYNC_ENDPOINT_URL=http://127.0.0.1:18090
BETTER_AUTH_SECRET=REPLACE_WITH_openssl_rand_hex_32
# "none": nothing in front of the API here, so X-Forwarded-For is ignored.
TRUSTED_PROXIES=none
REGISTRATION_OPEN=true
# Sign-in codes go to the server log instead of a mail provider.
EMAIL_CONSOLE=true

# PowerSync.
POWERSYNC_REPLICATION_PASSWORD=REPLACE_WITH_openssl_rand_hex_24
POWERSYNC_STORAGE_PASSWORD=REPLACE_WITH_openssl_rand_hex_24
PS_ADMIN_TOKEN=REPLACE_WITH_openssl_rand_hex_32
PS_SSLMODE=disable

# User media: MinIO stands in for R2. These are also MinIO's root credentials.
MEDIA_S3_BUCKET=vermillion-user-media
MEDIA_S3_ACCESS_KEY_ID=vermillion-prodcheck
MEDIA_S3_SECRET_ACCESS_KEY=REPLACE_WITH_openssl_rand_hex_32
# The public catalog-media bucket, on the same MinIO and credentials here.
EXERCISE_MEDIA_S3_BUCKET=vermillion-exercise-media
# Optional: addresses that hold the admin role (comma-separated).
ADMIN_EMAILS=
