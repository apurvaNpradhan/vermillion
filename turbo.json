{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:generate": {
      "cache": false,
      "interactive": true
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:start": {
      "cache": false
    },
    "db:stop": {
      "cache": false
    },
    "db:watch": {
      "cache": false,
      "persistent": true
    },
    "db:down": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["SESSION_OPEN_SKIP_TIMING"],
      "outputs": [],
      "passThroughEnv": ["TEST_DATABASE_ADMIN_URL", "SYNC_INFRA_TEST_ADMIN_URL"]
    },
    "//#test:root": {
      "cache": false,
      "outputs": []
    }
  },
  "globalEnv": [
    "APP_URL",
    "BETTER_AUTH_SECRET",
    "CI",
    "DATABASE_URL",
    "EXPO_PUBLIC_SERVER_URL",
    "EXPO_PUBLIC_SENTRY_DSN",
    "ADMIN_EMAILS",
    "EXERCISE_MEDIA_PUBLIC_URL",
    "EXERCISE_MEDIA_S3_ACCESS_KEY_ID",
    "EXERCISE_MEDIA_S3_BUCKET",
    "EXERCISE_MEDIA_S3_ENDPOINT",
    "EXERCISE_MEDIA_S3_REGION",
    "EXERCISE_MEDIA_S3_SECRET_ACCESS_KEY",
    "MEDIA_S3_ACCESS_KEY_ID",
    "MEDIA_S3_BUCKET",
    "MEDIA_S3_ENDPOINT",
    "MEDIA_S3_REGION",
    "MEDIA_S3_SECRET_ACCESS_KEY",
    "NODE_ENV",
    "POWERSYNC_REPLICATION_PASSWORD",
    "POWERSYNC_STORAGE_PASSWORD",
    "REGISTRATION_OPEN",
    "SENTRY_DSN",
    "SENTRY_RELEASE",
    "SYNC_ADMIN_DATABASE_URL",
    "SYNC_ENDPOINT_URL",
    "SYNC_SLOT_LAG_CRITICAL_MB",
    "SYNC_SLOT_LAG_WARN_MB",
    "TRUSTED_PROXIES"
  ],
  "globalDependencies": ["app.config.ts", ".env*", "apps/*/.env*", "packages/*/.env*"]
}
