{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -b --force ../../packages/i18n && tsc -b ../../packages/api ../../packages/client ../../packages/env ../../packages/shared && vite build",
    "serve": "vite preview",
    "typecheck": "tsc -b --force ../../packages/i18n && tsc -b ../../packages/api ../../packages/client ../../packages/env ../../packages/shared && vite build && tsc --noEmit && tsc --noEmit -p sw/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:offline": "playwright test -c playwright.offline.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@powersync/common": "2.5.0",
    "@powersync/web": "2.6.0",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-virtual": "^3.14.26",
    "@workspace/client": "workspace:*",
    "@workspace/env": "workspace:*",
    "@workspace/i18n": "workspace:*",
    "@workspace/shared": "workspace:*",
    "@workspace/sync": "workspace:*",
    "@workspace/ui": "workspace:*",
    "i18next": "^26.7.2",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.1.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@workspace/config": "workspace:*",
    "pg": "^8.23.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.4",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
