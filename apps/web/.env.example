# Public build-time values only: this file is bundled into the browser and the Worker.
# Public origin of the app. Web and API share it; the dev server proxies /api and /rpc.
VITE_SERVER_URL=http://localhost:3001
# Cloudflare Turnstile site key (optional; set it together with TURNSTILE_SECRET_KEY on the server).
# VITE_TURNSTILE_SITE_KEY=
