# Copy to .env for local development. Validated at startup (packages/env).
NODE_ENV=development
# Public origin of the API (https://basalt-api.<domain> in production). Auth links are built from it. With
# the dev tunnel this is the tunnel origin.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/vermillion
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# Comma-separated addresses that hold the admin role (the site's /admin). Empty: no admin.
ADMIN_EMAILS=
# Set REGISTRATION_OPEN=false for the closed beta: only an address with a live invite may sign up
# (existing accounts and ADMIN_EMAILS addresses still can).
REGISTRATION_OPEN=true
# Proxies allowed to set X-Forwarded-For (Traefik + Cloudflare ranges in production), or "none".
TRUSTED_PROXIES=127.0.0.0/8,::1/128
# Optional: CAPTCHA on sign-up, sign-in and password reset.
TURNSTILE_SECRET_KEY=
# Sentry error reporting (optional): the DSN of the Node project. SENTRY_RELEASE defaults to the app version.
SENTRY_DSN=
SENTRY_RELEASE=
# Optional: social sign-in, enabled only when both values are present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Email: without RESEND_API_KEY emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=
# Sync infrastructure (PowerSync). Development defaults match docker-compose.yml.
# Replication bootstrap (`pnpm sync:bootstrap`): URL-safe passwords, at least 16 characters.
POWERSYNC_REPLICATION_PASSWORD=powersync_local_replication
POWERSYNC_STORAGE_PASSWORD=powersync_local_storage
# Privileged URL for the bootstrap. Production: a role with CREATEROLE, CREATEDB and
# REPLICATION (or superuser), separate from DATABASE_URL. Defaults to DATABASE_URL.
SYNC_ADMIN_DATABASE_URL=
# Public PowerSync URL given to clients (required in production; dev defaults to 127.0.0.1:8090).
SYNC_ENDPOINT_URL=
# Replication slot lag in MiB: warn, and critical (marks /api/ready degraded).
SYNC_SLOT_LAG_WARN_MB=1024
SYNC_SLOT_LAG_CRITICAL_MB=3072
# User media (ADR 0040): the private S3 bucket. Development defaults match the MinIO of
# docker-compose.yml. Production: a private R2 bucket, its S3 endpoint
# (https://<account>.r2.cloudflarestorage.com) and an API token scoped to that bucket.
MEDIA_S3_ENDPOINT=http://127.0.0.1:9000
MEDIA_S3_REGION=auto
MEDIA_S3_BUCKET=vermillion-user-media
MEDIA_S3_ACCESS_KEY_ID=vermillion
MEDIA_S3_SECRET_ACCESS_KEY=vermillion-local-secret
# Catalog exercise media (the admin's uploads): the public bucket. Development defaults match the
# MinIO of docker-compose.yml. Production: an R2 bucket with the custom domain media.<domain>, its
# S3 endpoint and an API token scoped to that bucket only.
EXERCISE_MEDIA_S3_ENDPOINT=http://127.0.0.1:9000
EXERCISE_MEDIA_S3_REGION=auto
EXERCISE_MEDIA_S3_BUCKET=vermillion-exercise-media
EXERCISE_MEDIA_S3_ACCESS_KEY_ID=vermillion
EXERCISE_MEDIA_S3_SECRET_ACCESS_KEY=vermillion-local-secret
# Where its objects are read; defaults to https://media.<domain> in production, MinIO locally.
EXERCISE_MEDIA_PUBLIC_URL=
