# Copy to .env for local development. Validated at startup (packages/env).
NODE_ENV=development
# Public web origin. Auth links are built from it; in dev Vite proxies /api and /rpc to the server.
APP_URL=http://localhost:3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/vermillion
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# Comma-separated verified emails that get the admin role.
ADMIN_EMAILS=
# Set REGISTRATION_OPEN=false to close sign-ups (admin emails can still register).
REGISTRATION_OPEN=true
# Proxies allowed to set X-Forwarded-For (Traefik + Cloudflare ranges in production), or "none".
TRUSTED_PROXIES=127.0.0.0/8,::1/128
# Optional: CAPTCHA on sign-up, sign-in and password reset.
TURNSTILE_SECRET_KEY=
# Optional: social sign-in, enabled only when both values are present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Email: without RESEND_API_KEY emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=
# Sync infrastructure (PowerSync). Development defaults match docker-compose.yml.
# Replication bootstrap (`pnpm sync:bootstrap`): URL-safe passwords, at least 16 characters.
POWERSYNC_REPLICATION_PASSWORD=powersync_local_replication
POWERSYNC_STORAGE_PASSWORD=powersync_local_storage
# Privileged URL for the bootstrap. Production: a role with CREATEROLE, CREATEDB and
# REPLICATION (or superuser), separate from DATABASE_URL. Defaults to DATABASE_URL.
SYNC_ADMIN_DATABASE_URL=
# Public PowerSync URL given to clients (required in production; dev defaults to 127.0.0.1:8090).
SYNC_ENDPOINT_URL=
# Replication slot lag in MiB: warn, and critical (marks /api/ready degraded).
SYNC_SLOT_LAG_WARN_MB=1024
SYNC_SLOT_LAG_CRITICAL_MB=3072
