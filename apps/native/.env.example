# Public build-time values only: EXPO_PUBLIC_* is inlined into the app bundle.
# Public origin of the API server. On a physical device use your machine's LAN address.
EXPO_PUBLIC_SERVER_URL=http://localhost:3000
# Cloudflare Turnstile site key (optional; set it together with TURNSTILE_SECRET_KEY on the server).
# EXPO_PUBLIC_TURNSTILE_SITE_KEY=
